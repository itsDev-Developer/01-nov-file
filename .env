# Settings for the bot. config.py reads this file at start-up.
# Real environment variables (Heroku config vars, `docker run -e`, ...) override anything here.
# Format: NAME=value  - no quotes, no spaces around '=', comments on their own lines.
# Contains secrets: keep this file private (it is listed in .gitignore).

# --- Telegram bot (REQUIRED) -----------------------------------------------
# Token from @BotFather.
BOT_TOKEN=8673050041:AAEJ1B5RYXHEKWSWn76Fc7eKrfkb1wJxOvw
# From https://my.telegram.org -> API development tools.
API_ID=24260003
# Same page as API_ID.
API_HASH=a7fb5ac26f0e0a5742c43675fdec8f54
# Your numeric Telegram user id. The owner is always an admin.
OWNER_ID=8514738063
# Comma-separated admin user ids.
ADMINS=6155357947,8514738063

# --- Database (REQUIRED) ---------------------------------------------------
# MongoDB connection string. Percent-encode special characters in the password.
DB_URI=mongodb+srv://Manga:Manga@cluster0.bcufj5q.mongodb.net/?appName=Cluster0
# Database name (created automatically).
DB_NAME=Manga
# Primary storage channel; the bot must be an admin there. More channels: /adddb.
DB_CHANNEL=-1003770799017

# --- Web server and links --------------------------------------------------
# !! SET THIS !! Public HTTPS address of this server. Needed for the Unlock button, watch page, API docs and API links.
WEBAPP_URL=https://your-app-domain.example.com
# Port the web server listens on. Hosts that provide $PORT override it automatically.
PORT=5010
# Secret in the Monetag postback URL. If you change it, run /postbackurl again and paste the new URL into Monetag.
POSTBACK_SECRET=bcEIgseZlR2bgUucSUn42QaWxNphZcbB

# --- Bot behaviour ---------------------------------------------------------
# Name of the Pyrogram session.
SESSION=Suzune
# Pyrogram worker count.
WORKERS=5
# Force-subscribe channels: [[channel_id, request_to_join(true/false), invite_link_minutes], ...]. More can be added from the bot.
FSUBS=[[-1002104093408, false, 10]]
# Seconds before delivered files are deleted from the chat. 0 = never.
AUTO_DEL=600
# true = delivered files can't be forwarded or saved.
PROTECT=false
# true = no Share button on stored posts.
DISABLE_BTN=true
# Message effect id used on the /start message.
MSG_EFFECT=5046509860389126442

# --- Ads (Monetag / Adsterra) ----------------------------------------------
# Monetag SDK address.
MONETAG_SDK_SRC=//libtl.com/sdk.js
# Example zone id shown in the admin panel only. Real zones are set with /adssettings.
DEFAULT_AD_ZONE=10739699
# Seconds an unlock link stays valid.
VERIFY_SESSION_TTL=600
# Anti-bypass: minimum plausible seconds per ad step.
MIN_AD_STEP_SECONDS=2
# Let a user through after this many failed attempts at one ad. 0 = never.
AD_FAIL_OPEN_AFTER=3
# Default height (px) reserved for the native banner. Also: /bannerheight.
BANNER_MIN_HEIGHT=300

# --- Public API ------------------------------------------------------------
# false = the API answers 503.
API_ENABLED=true
# Requests per minute per API key.
API_RATE_LIMIT_PER_MIN=60
# Maximum files in one batch link.
API_MAX_BATCH=100
# Maximum size of one uploaded file.
API_MAX_UPLOAD_MB=512

# --- Premium and landing page ----------------------------------------------
# Where Buy/Activate/Renew buttons point until you run /setpremiumurl.
DEFAULT_PREMIUM_URL=https://t.me/Uchiha_Community
# Telegram username (no @) for 'Buy this bot / Hire me' on the landing page.
CONTACT_USERNAME=tojma

# --- Link shortener (the admin panel can change these live) ----------------
# Shortener domain.
SHORT_URL=uchihalinks.gt.tc
# Shortener API key.
SHORT_API=
# Tutorial link shown with the short link.
SHORT_TUT=https://t.me/hw2openlinks

# --- Images ----------------------------------------------------------------
# Picture on the /start message.
START_PHOTO=https://graph.org/file/510affa3d4b6c911c12e3.jpg
# Picture on the join-channels prompt.
FSUB_PHOTO=https://telegra.ph/file/7a16ef7abae23bd238c82-b8fbdcb05422d71974.jpg
# Picture on the short-link message.
SHORT_PIC=https://telegra.ph/file/7a16ef7abae23bd238c82-b8fbdcb05422d71974.jpg
# Second short-link picture.
SHORT_IMAGE=https://telegra.ph/file/8aaf4df8c138c6685dcee-05d3b183d4978ec347.jpg
# Picture on the 'Unlock & Watch' message.
UNLOCK_PHOTO=https://telegra.ph/file/7a16ef7abae23bd238c82-b8fbdcb05422d71974.jpg

# --- Logging ---------------------------------------------------------------
# Log file.
LOG_FILE_NAME=bot.log
# Size of one log file. Total disk use is about (LOG_BACKUPS + 1) x this.
LOG_MAX_MB=50
# Rotated log files to keep.
LOG_BACKUPS=10
